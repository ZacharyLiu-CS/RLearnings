/* ============================================================
   瑞士风格（Swiss Style）小程序全局样式
   - 无衬线字体、严格栅格、纸白底 + 墨黑字 + 单一强调红
   - 发丝分隔线、极小圆角、无阴影、微标签全大写加字距
   ============================================================ */
page {
  --paper: #ffffff;
  --paper-dim: #f4f4f1;
  --paper-soft: #ececea;
  --ink: #111111;
  --ink-dim: #5c5c58;
  --ink-faint: #8f8f88;
  --line: #dcdcd6;
  --accent: #d4321f;
  --accent-dim: rgba(212, 50, 31, 0.08);
  --font: 'Helvetica Neue', Helvetica, 'PingFang SC', system-ui, sans-serif;
  --font-ru: 'Helvetica Neue', Helvetica, Georgia, serif;

  background: var(--paper);
  color: var(--ink);
  font-family: var(--font);
  font-size: 30rpx;
  line-height: 1.5;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  padding: 28rpx;
}

.micro {
  font-size: 22rpx;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.spacer {
  flex: 1;
}

.muted {
  color: var(--ink-dim);
}

.faint {
  color: var(--ink-faint);
}

.title-ru {
  font-family: var(--font-ru);
  font-size: 40rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 4rpx;
  border: 1rpx solid var(--ink);
  background: var(--paper);
  color: var(--ink);
  font-size: 29rpx;
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 600;
}

.btn-danger {
  color: var(--accent);
  border-color: var(--accent);
}

.btn-ghost {
  border-color: var(--line);
  color: var(--ink-dim);
}

.input {
  width: 100%;
  min-height: 84rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 29rpx;
}

.textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 29rpx;
}

.picker {
  min-height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 4rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink-dim);
  font-size: 28rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink-dim);
  font-size: 26rpx;
}

.chip-active {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}

.badge {
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  color: var(--ink-dim);
  font-size: 22rpx;
  letter-spacing: 0.04em;
}

.badge-new {
  color: #1a4cd0;
  border-color: #1a4cd0;
}

.badge-learning {
  color: #a35a00;
  border-color: #a35a00;
}

.badge-reviewing {
  color: #0f6b4f;
  border-color: #0f6b4f;
}

.badge-mastered {
  color: var(--ink);
  border-color: var(--ink);
}

.progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--paper-soft);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--accent);
}
