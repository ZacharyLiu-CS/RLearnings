.ring-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}

.center-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.ring-value {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
}

.ring-check {
  font-size: 52rpx;
  color: #0f6b4f;
  line-height: 1;
}

.ring-legend {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.legend-value {
  font-size: 24rpx;
}

.summary {
  margin-bottom: 8rpx;
}

.flashcard {
  margin-top: 24rpx;
  min-height: 520rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
}

.face {
  width: 100%;
  padding: 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.flash-ru {
  font-size: 64rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.reveal-token {
  margin-right: 8rpx;
}

.reveal-token:last-child {
  margin-right: 0;
}

.flash-ru-small {
  font-size: 44rpx;
}

.flash-zh {
  font-size: 42rpx;
}

.small {
  font-size: 26rpx;
}

.italic {
  font-style: italic;
}

.tags {
  flex-wrap: wrap;
  justify-content: center;
}

.hint {
  font-size: 24rpx;
  margin-top: 24rpx;
}

.ratings {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.rate {
  flex: 1;
}

.rate-danger {
  border-color: rgba(212, 50, 31, 0.5);
}

.rate-warn {
  border-color: rgba(163, 90, 0, 0.5);
}

.rate-success {
  border-color: rgba(15, 107, 79, 0.5);
}

.reward {
  border-left: 6rpx solid #0f6b4f;
}

.reward-head {
  gap: 12rpx;
}

.reward-check {
  color: #0f6b4f;
  font-size: 32rpx;
}

.reward-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f6b4f;
}

.reward-text {
  display: block;
  font-size: 26rpx;
  margin: 12rpx 0 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
}
