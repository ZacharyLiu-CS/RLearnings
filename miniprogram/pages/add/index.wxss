.tabs {
  display: flex;
  gap: 8rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  color: var(--text-dim);
  font-size: 28rpx;
}

.tab-active {
  background: var(--accent-soft);
  color: #cfe0ff;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  color: var(--text-dim);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.save-btn {
  margin-top: 12rpx;
}

.summary {
  margin-top: 20rpx;
}

.btn-sm {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.preview {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.preview-row {
  padding: 6rpx 0;
}

.preview-ru {
  font-size: 32rpx;
}

.tip {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 176, 32, 0.1);
  color: var(--warn);
  font-size: 24rpx;
}

.drafts {
  margin-top: 24rpx;
}

.draft-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.draft-input {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
}

.draft-low .draft-input {
  border-color: rgba(255, 176, 32, 0.55);
  background: rgba(255, 176, 32, 0.08);
}
