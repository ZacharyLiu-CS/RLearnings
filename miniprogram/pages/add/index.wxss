.tabs {
  display: flex;
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: var(--paper);
  color: var(--ink-dim);
  font-size: 27rpx;
  border-right: 1rpx solid var(--line);
}

.tab:last-child {
  border-right: none;
}

.tab-active {
  background: var(--ink);
  color: #fff;
}

.label {
  display: block;
  color: var(--ink-dim);
  margin-bottom: 12rpx;
}

.input {
  margin-bottom: 16rpx;
}

.textarea.short {
  min-height: 160rpx;
}

.save-btn {
  margin-top: 12rpx;
}

.summary {
  margin-top: 20rpx;
}

.btn-sm {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
}

.actions {
  margin-top: 24rpx;
}

.drafts {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 20rpx;
}

.draft-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.draft-input {
  flex: 1;
  min-height: 72rpx;
  font-size: 27rpx;
  margin-bottom: 0;
}

.draft-low .draft-input {
  border-color: var(--accent);
  background: var(--accent-dim);
}

.ai-draft {
  border-top: 1rpx solid var(--line);
  padding: 20rpx 0;
}

.ai-draft .input {
  flex: 1;
  margin-bottom: 0;
  min-height: 72rpx;
  font-size: 27rpx;
}

.draft-ru {
  font-family: var(--font-ru);
}

.example {
  font-style: italic;
  margin-top: 8rpx;
}

.tags {
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.notice {
  margin-top: 20rpx;
  padding: 20rpx;
  border-left: 6rpx solid var(--accent);
  background: var(--paper-dim);
  font-size: 25rpx;
}

.link {
  color: var(--accent);
  text-decoration: underline;
}

.preview {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 16rpx;
}

.preview-row {
  padding: 6rpx 0;
}

.preview-ru {
  font-size: 32rpx;
}

.tiny {
  font-size: 22rpx;
}
