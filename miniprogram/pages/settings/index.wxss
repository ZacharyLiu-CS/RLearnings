.title {
  display: block;
  color: var(--ink);
}

.desc {
  display: block;
  font-size: 26rpx;
  margin: 12rpx 0 32rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  color: var(--ink-dim);
  margin-bottom: 10rpx;
}

.custom {
  margin-top: 12rpx;
}

.link {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--accent);
  text-decoration: underline;
}

.notice {
  padding: 20rpx;
  border-left: 6rpx solid var(--accent);
  background: var(--paper-dim);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.notice-ok {
  border-left-color: #0f6b4f;
}

.notice-bad {
  border-left-color: var(--accent);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.foot {
  display: block;
  margin-top: 24rpx;
}

.tiny {
  font-size: 22rpx;
}
