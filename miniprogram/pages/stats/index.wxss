.cards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric {
  flex: 1;
  min-width: 45%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  font-size: 24rpx;
}

.metric-value {
  font-size: 48rpx;
  font-weight: 600;
}

.warn {
  color: var(--warn);
}

.success {
  color: var(--success);
}

.section-title {
  display: block;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.curve {
  display: flex;
  gap: 12rpx;
  height: 240rpx;
}

.curve-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  height: 100%;
}

.curve-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
}

.curve-bar {
  width: 100%;
  min-height: 6rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #4f8cff, rgba(79, 140, 255, 0.25));
}

.tiny {
  font-size: 22rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dist-label {
  width: 100rpx;
  font-size: 26rpx;
}

.dist-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
  overflow: hidden;
}

.dist-fill {
  height: 100%;
}

.dist-count {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-sm {
  min-height: 72rpx;
  font-size: 28rpx;
}

.storage {
  display: block;
  margin-top: 20rpx;
}
