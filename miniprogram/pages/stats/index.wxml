<view class="page">
  <view class="cards">
    <view class="card metric">
      <text class="faint label">总条目</text>
      <text class="metric-value">{{total}}</text>
    </view>
    <view class="card metric">
      <text class="faint label">今日待复习</text>
      <text class="metric-value warn">{{due}}</text>
    </view>
    <view class="card metric">
      <text class="faint label">已掌握</text>
      <text class="metric-value success">{{mastered}}</text>
    </view>
    <view class="card metric">
      <text class="faint label">连续打卡</text>
      <text class="metric-value">{{streak}} 天</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">近 7 天复习量</text>
    <view class="curve">
      <view wx:for="{{curve}}" wx:key="day" class="curve-col">
        <view class="curve-track">
          <view class="curve-bar" style="height: {{item.percent}}%" />
        </view>
        <text class="faint tiny">{{item.day}}</text>
        <text class="faint tiny">{{item.count}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">掌握进度分布</text>
    <view wx:for="{{dist}}" wx:key="label" class="dist-row">
      <text class="faint dist-label">{{item.label}}</text>
      <view class="dist-track">
        <view class="dist-fill" style="width: {{item.percent}}%; background: {{item.color}}" />
      </view>
      <text class="muted dist-count">{{item.count}}</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">数据管理</text>
    <view class="actions">
      <view class="btn btn-sm" bindtap="onExportJson">导出 JSON（复制到剪贴板）</view>
      <view class="btn btn-sm" bindtap="onExportCsv">导出 CSV</view>
      <view class="btn btn-sm" bindtap="onImport">从剪贴板导入</view>
      <view class="btn btn-sm" bindtap="onSeed">生成演示数据</view>
      <view class="btn btn-sm btn-danger" bindtap="onClear">清空数据</view>
    </view>
    <text class="faint tiny storage">本地存储占用约 {{storageKb}} KB / 上限 10240 KB</text>
  </view>
</view>
