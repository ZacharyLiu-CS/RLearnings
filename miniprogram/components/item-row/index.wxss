.row-item {
  /* 与列表窗口化计算保持一致（ROW_HEIGHT = 76） */
  height: 76px;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}

.main {
  flex: 1;
  min-width: 0;
}

.head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.sub {
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.meta-line {
  font-size: 22rpx;
}

.actions {
  display: flex;
  gap: 8rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--text-dim);
  font-size: 28rpx;
}

.icon-btn.danger {
  color: var(--danger);
}
